# ============================================================================
# CTF OSINT Toolkit - Root .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# OS / Editor
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ----------------------------------------------------------------------------
# Environment / Secrets
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
secrets/

# ============================================================================
# Backend (Python / FastAPI)
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
develop-eggs/
sdist/
wheels/
*.egg

# Testing / Coverage
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers / Linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# SQLite database & runtime data
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.sqlite-journal
backend/data/uploads/

# Logs
*.log
logs/

# ============================================================================
# Frontend (Node / Vite / React)
# ============================================================================
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Vite
.vite/

# Testing
coverage/

# Misc
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ESLint / Prettier
.eslintcache

# ----------------------------------------------------------------------------
# Project specific
# ----------------------------------------------------------------------------
# Keep the data folder in git but ignore its contents (use .gitkeep)
!backend/data/.gitkeep
