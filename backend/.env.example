# ============================================================================
# Deutsch-Lernassistent - Backend environment template
# Copy to `.env` and adjust as needed:  cp .env.example .env
# ============================================================================

# Application
APP_NAME="Deutsch-Lernassistent"
APP_ENV="development"
DEBUG=true

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (SQLite, relative to backend/ )
DATABASE_URL="sqlite+aiosqlite:///./data/german.db"

# API version prefix
API_V1_PREFIX="/api/v1"

# AI Configuration
AI_PROVIDER="gemini"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# Explanation configs
EXPLANATION_LANGUAGE="uz"
